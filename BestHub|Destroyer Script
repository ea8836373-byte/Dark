-- 5. Fling Kill Destroyer
AddKillingToggle("Fling Kill Destroyer", function(state)
    _G.FlingKill = state
    task.spawn(function()
        local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        local bodyGyro = Instance.new("BodyGyro", hrp)
        bodyGyro.P = 9e9
        bodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
        
        while _G.FlingKill do
            pcall(function()
                bodyGyro.cframe = hrp.CFrame * CFrame.Angles(0, math.rad(300), 0)
                for _, enemy in pairs(game:GetService("Players"):GetPlayers()) do
                    if enemy ~= Player and enemy.Character and enemy.Character:FindFirstChild("HumanoidRootPart") then
                        hrp.CFrame = enemy.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 0.05)
                    end
                end
            end)
            game:GetService("RunService").Heartbeat:Wait()
        end
        bodyGyro:Destroy()
    end)
end)

