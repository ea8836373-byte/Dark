-- --- TOGGLE BUTTON CREATOR ---
local function AddKillingToggle(text, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, -10, 0, 40)
    Btn.BackgroundColor3 = DarkGray
    Btn.Text = text .. " : Disabled"
    Btn.TextColor3 = TextColor
    Btn.TextSize = 12
    Btn.Font = Enum.Font.GothamBold
    Btn.BorderSizePixel = 0
    Btn.Parent = Container

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 5)
    Corner.Parent = Btn

    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Color3.fromRGB(45, 45, 50)
    Stroke.Thickness = 1
    Stroke.Parent = Btn

    local enabled = false
    Btn.MouseButton1Click:Connect(function()
        enabled = not enabled
        if enabled then
            Btn.BackgroundColor3 = Color3.fromRGB(25, 12, 40)
            Stroke.Color = DestroyerPurple
            Btn.Text = text .. " : Enabled"
        else
            Btn.BackgroundColor3 = DarkGray
            Stroke.Color = Color3.fromRGB(45, 45, 50)
            Btn.Text = text .. " : Disabled"
        end
        callback(enabled)
    end)
end

-- --- FEATURES CATEGORIES FROM THE VIDEO ---

-- 1. Kill Aura
AddKillingToggle("Kill Aura", function(state)
    _G.KillAura = state
    task.spawn(function()
        while _G.KillAura do
            pcall(function()
                for _, enemy in pairs(game:GetService("Players"):GetPlayers()) do
                    if enemy ~= Player and enemy.Character and enemy.Character:FindFirstChild("HumanoidRootPart") then
                        local distance = (Player.Character.HumanoidRootPart.Position - enemy.Character.HumanoidRootPart.Position).Magnitude
                        if distance < 15 then
                            local tool = Player.Character:FindFirstChildOfClass("Tool")
                            if tool then 
                                tool:Activate()
                                firetouchinterest(enemy.Character.HumanoidRootPart, tool.Handle, 0)
                                firetouchinterest(enemy.Character.HumanoidRootPart, tool.Handle, 1)
                            end
                        end
                    end
                end
            end)
            task.wait(0.1)
        end
    end)
end)

