-- ==========================================
-- CATEGORIA 4: VIEW STATS
-- ==========================================
local StatsTab = Window:CreateTab("View Stats", 4483345998)

StatsTab:CreateButton({
   Name = "Print Server Leaderboard Stats",
   Callback = function()
      for _, plyr in pairs(game.Players:GetChildren()) do
         local leaderstats = plyr:FindFirstChild("leaderstats")
         local k = leaderstats and leaderstats:FindFirstChild("Kills") and leaderstats.Kills.Value or 0
         local r = leaderstats and leaderstats:FindFirstChild("Rebirths") and leaderstats.Rebirths.Value or 0
         
         -- Fix: Genera una notifica Rayfield pulita in-game senza aprire la console
         Rayfield:Notify({
            Title = "Stats: " .. plyr.Name,
            Content = "Kills: " .. tostring(k) .. " | Rebirths: " .. tostring(r),
            Duration = 3
         })
      end
   end,
})

